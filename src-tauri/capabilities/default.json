{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "ClearScan 默认权限：文档库(SQLite)、文件读写(AppData)、系统对话框、分享",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "sql:default",
    "dialog:default",
    "shell:default",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-read-dir",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:allow-remove",
    "fs:allow-copy-file",
    "fs:allow-rename",
    "fs:allow-appdata-read-recursive",
    "fs:allow-appdata-write-recursive",
    "fs:allow-appconfig-read-recursive",
    "fs:allow-appconfig-write-recursive",
    "fs:allow-appcache-read-recursive",
    "fs:allow-appcache-write-recursive"
  ]
}
